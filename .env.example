# ──────────────────────────────────────────────────────────────
# FinPilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Django Core ────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-to-a-real-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────
# Local SQLite (development only):
# DATABASE_URL=sqlite:///db.sqlite3
#
# Supabase PostgreSQL (production):
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URL for best performance with Django:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── Redis (optional — for caching & Celery) ────────────────────
CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Email ──────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FinPilot <noreply@finpilot.app>

# ── CORS ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── App ────────────────────────────────────────────────────────
CURRENCY_SYMBOL=$
CURRENCY_CODE=USD

# ── DRF Throttling (optional overrides) ───────────────────────
DRF_ANON_THROTTLE=100/day
DRF_USER_THROTTLE=1000/day
DRF_AUTH_THROTTLE=10/min
DRF_REPORT_THROTTLE=20/hour

# ── Sentry (optional — production error tracking) ─────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
GIT_COMMIT_SHA=

# ── Gunicorn (optional overrides) ─────────────────────────────
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
